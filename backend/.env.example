# Supabase — Project Settings > API in your Supabase dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Razorpay test mode — Account & Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-test-key-secret-here

# OpenRouter — for the diagnosis engine (Task B), not needed for Task A
OPENROUTER_API_KEY=your-openrouter-key-here

# Default number of synthetic transactions per batch. Original demo default was 60;
# reduced for faster local testing and demo runs. Change freely — every place that needs
# this value reads it from here, nothing else needs editing.
DEFAULT_BATCH_SIZE=30
